# Server-side provider key. Never expose this to browser code.
API_FOOTBALL_KEY=

# PostgreSQL connection used by ingestion, analytics jobs, and server-side web reads.
# Never expose this as NEXT_PUBLIC_DATABASE_URL.
# Example for local development only:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/football_intelligence
DATABASE_URL=

# Internal diagnostics route. Keep false/unset for public production deployments.
INTERNAL_LAB_ENABLED=false
